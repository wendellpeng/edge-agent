<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="Edge Agent"
           Language="2052"
           Version="$(var.Version)"
           Manufacturer="Zoomlion"
           UpgradeCode="A1B2C3D4-E5F6-7890-ABCD-EF1234567890">

    <Package InstallerVersion="200" Compressed="yes" InstallScope="perMachine" />

    <MajorUpgrade DowngradeErrorMessage="A newer version is already installed." />

    <Media Id="1" Cabinet="media1.cab" EmbedCab="yes" />

    <!-- Application Icon -->
    <Icon Id="AppIcon.ico" SourceFile="assets\app-icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />

    <!-- Installation Directory -->
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLDIR" Name="Edge Agent">

          <!-- Main Program -->
          <Component Id="MainBinary" Guid="B1A2C3D4-E5F6-7890-ABCD-EF1234567891">
            <File Id="EdgeAgentEXE" Name="edge-agent.exe" Source="target\$(var.Profile)\edge-agent.exe" KeyPath="yes" />
          </Component>

          <!-- Tray Program -->
          <Component Id="TrayBinary" Guid="B1A2C3D4-E5F6-7890-ABCD-EF1234567892">
            <File Id="EdgeAgentTrayEXE" Name="edge-agent-tray.exe" Source="target\$(var.Profile)\edge-agent-tray.exe" KeyPath="yes" />
          </Component>

          <!-- Tray Auto-start Registry -->
          <Component Id="TrayStartup" Guid="B1A2C3D4-E5F6-7890-ABCD-EF1234567893">
            <RegistryValue Root="HKCU"
                           Key="Software\Microsoft\Windows\CurrentVersion\Run"
                           Name="EdgeAgentTray"
                           Value="[INSTALLDIR]edge-agent-tray.exe"
                           Type="string"
                           KeyPath="yes" />
          </Component>

        </Directory>
      </Directory>

      <!-- Start Menu Shortcut -->
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="Edge Agent">
          <Component Id="ApplicationShortcut" Guid="B1A2C3D4-E5F6-7890-ABCD-EF1234567894">
            <Shortcut Id="ApplicationStartMenuShortcut"
                      Name="Edge Agent"
                      Description="Edge vision inspection and data collection agent"
                      Target="[INSTALLDIR]edge-agent-tray.exe"
                      WorkingDirectory="INSTALLDIR"
                      Icon="AppIcon.ico" />
            <RemoveFolder Id="ApplicationProgramsFolder" On="uninstall" />
            <RegistryValue Root="HKCU" Key="Software\EdgeAgent" Name="installed" Type="integer" Value="1" KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>

      <!-- Desktop Shortcut -->
      <Directory Id="DesktopFolder">
        <Component Id="DesktopShortcut" Guid="B1A2C3D4-E5F6-7890-ABCD-EF1234567895">
          <Shortcut Id="DesktopShortcut"
                    Name="Edge Agent"
                    Description="Edge vision inspection and data collection agent"
                    Target="[INSTALLDIR]edge-agent-tray.exe"
                    WorkingDirectory="INSTALLDIR"
                    Icon="AppIcon.ico" />
          <RegistryValue Root="HKCU" Key="Software\EdgeAgent" Name="desktop" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </Directory>

    <!-- Custom Actions: Service Install/Uninstall -->
    <CustomAction Id="InstallServiceCA"
                  Directory="INSTALLDIR"
                  ExeCommand="[SystemFolder]sc.exe create EdgeAgent binPath= &quot;\&quot;[INSTALLDIR]edge-agent.exe\&quot;&quot; start= auto displayname= &quot;Edge Agent&quot;"
                  Execute="deferred"
                  Return="check"
                  Impersonate="no" />

    <CustomAction Id="StartServiceCA"
                  Directory="INSTALLDIR"
                  ExeCommand="[SystemFolder]sc.exe start EdgeAgent"
                  Execute="deferred"
                  Return="ignore"
                  Impersonate="no" />

    <CustomAction Id="StopServiceCA"
                  Directory="INSTALLDIR"
                  ExeCommand="[SystemFolder]sc.exe stop EdgeAgent"
                  Execute="deferred"
                  Return="ignore"
                  Impersonate="no" />

    <CustomAction Id="DeleteServiceCA"
                  Directory="INSTALLDIR"
                  ExeCommand="[SystemFolder]sc.exe delete EdgeAgent"
                  Execute="deferred"
                  Return="ignore"
                  Impersonate="no" />

    <CustomAction Id="StartTrayCA"
                  Directory="INSTALLDIR"
                  ExeCommand="[INSTALLDIR]edge-agent-tray.exe"
                  Execute="commit"
                  Return="asyncNoWait"
                  Impersonate="yes" />

    <!-- Install: Register service and start -->
    <InstallExecuteSequence>
      <Custom Action="InstallServiceCA" After="InstallFiles">
        <![CDATA[NOT Installed]]>
      </Custom>
      <Custom Action="StartServiceCA" After="InstallServiceCA">
        <![CDATA[NOT Installed]]>
      </Custom>
      <Custom Action="StartTrayCA" After="StartServiceCA">
        <![CDATA[NOT Installed]]>
      </Custom>

      <!-- Uninstall: Stop and delete service -->
      <Custom Action="StopServiceCA" Before="RemoveFiles">
        <![CDATA[(Installed OR UPGRADINGPRODUCTCODE) AND NOT REINSTALL]]>
      </Custom>
      <Custom Action="DeleteServiceCA" After="StopServiceCA">
        <![CDATA[(Installed OR UPGRADINGPRODUCTCODE) AND NOT REINSTALL]]>
      </Custom>
    </InstallExecuteSequence>

    <!-- Feature -->
    <Feature Id="MainFeature" Title="Edge Agent" Level="1">
      <ComponentRef Id="MainBinary" />
      <ComponentRef Id="TrayBinary" />
      <ComponentRef Id="TrayStartup" />
      <ComponentRef Id="ApplicationShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

  </Product>
</Wix>
